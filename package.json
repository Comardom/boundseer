{
  "name": "boundseer",
  "version": "0.4.0",
  "description": "Show layout bounds on your page.",
  "private": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "dom",
    "layout",
    "layout-bounds",
    "debug",
    "developer-tools",
    "overlay",
    "browser"
  ],
  "author": "Comardom",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
