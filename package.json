{
  "name": "boundseer",
  "version": "0.6.1",
  "description": "Show layout bounds on your page.",
  "private": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "dom",
    "layout",
    "layout-bounds",
    "debug",
    "developer-tools",
    "overlay",
    "browser"
  ],
  "author": "Comardom",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "devDependencies": {
    "@vitest/ui": "^5.0.3",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
